{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "verbatimModuleSyntax": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/core/**/*.ts",
    "src/types/**/*.d.ts",
    "tests/**/*.ts",
    "tools/**/*.mts"
  ],
  "exclude": ["src/core/bootstrap.js"]
}
